<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 on Windows: LibreHardwareMonitorLib needs the Windows kernel driver (Ring0) -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>lhm-sidecar</AssemblyName>
    <RootNamespace>LhmSidecar</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Bundling hints for later packaging as a Tauri "sidecar" binary.
      Build the distributable exe with a self-contained publish (see build-sidecar.bat).
      These properties make dotnet publish emit a single self-contained .exe
      (no .NET runtime required on the target machine). They are scoped to
      publish so a plain dotnet build stays fast.
    -->
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">true</PublishSingleFile>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Tauri expects sidecars named <name>-<target-triple>.exe, e.g. lhm-sidecar-x86_64-pc-windows-msvc.exe -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Deep hardware sensor access (motherboard SIO, fan control, MSR, GPU, SMART). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*" />
    <!-- System.Text.Json ships in the net8.0 BCL; reference pinned for clarity. -->
    <PackageReference Include="System.Text.Json" Version="8.0.*" />
  </ItemGroup>

</Project>
