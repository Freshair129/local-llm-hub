{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewVerdict",
  "description": "Structured review and verification gate schema (SPEC-EVAL-002 GAP-004)",
  "type": "object",
  "required": ["schema_version", "verdict", "blocking_findings", "warnings", "ac_results", "confidence"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "ESCALATE"]
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ac_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["satisfied"],
        "properties": {
          "satisfied": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "suggested_repair": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
