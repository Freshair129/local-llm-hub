{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalRunResult",
  "description": "Standardized evaluation run result with full reproducibility bindings (SPEC-EVAL-002 Section 8)",
  "type": "object",
  "required": [
    "run_id",
    "benchmark_id",
    "task_id",
    "model",
    "machine",
    "runtime",
    "repo_commit",
    "started_at",
    "finished_at",
    "hard_gates",
    "verdict"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "benchmark_id": { "type": "string" },
    "task_id": { "type": "string" },
    "model": {
      "type": "object",
      "required": ["id", "quant"],
      "properties": {
        "id": { "type": "string" },
        "sha256": { "type": "string" },
        "quant": { "type": "string" },
        "family": { "type": "string" }
      }
    },
    "machine": {
      "type": "object",
      "required": ["machine_id", "cpu", "ram_gb", "gpu"],
      "properties": {
        "machine_id": { "type": "string" },
        "cpu": { "type": "string" },
        "ram_gb": { "type": "number" },
        "gpu": { "type": "string" },
        "driver": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["engine", "version"],
      "properties": {
        "engine": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "repo_commit": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "duration_seconds": { "type": "number" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt_tokens": { "type": "integer" },
        "completion_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "tokens_per_second": { "type": "number" }
      }
    },
    "hard_gates": {
      "type": "object",
      "required": ["hg_01_patch_valid", "hg_02_compile", "hg_03_existing_tests"],
      "properties": {
        "hg_01_patch_valid": { "type": "boolean" },
        "hg_02_compile": { "type": "boolean" },
        "hg_03_existing_tests": { "type": "boolean" },
        "hg_04_hidden_tests": { "type": "boolean" },
        "hg_05_security_checks": { "type": "boolean" },
        "hg_06_scope_clean": { "type": "boolean" }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INVALID", "ESCALATE"]
    },
    "failure_labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_logs": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
