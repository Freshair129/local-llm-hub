{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatchArtifact",
  "description": "Unified diff and file patch contract for worker implementations (SPEC-EVAL-002 GAP-003)",
  "type": "object",
  "required": ["task_id", "files"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "patch"],
        "properties": {
          "path": { "type": "string" },
          "patch": { "type": "string" },
          "reason": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["modify", "create", "delete"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
